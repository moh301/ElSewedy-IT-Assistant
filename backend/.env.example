# Copy this file to .env and adjust as needed (or just export these
# variables in your shell / hosting provider's dashboard).

# Port the server listens on.
PORT=8787

# Secret key the /admin dashboard and the GET/PATCH endpoints require via
# the "x-api-key" header. Change this before deploying anywhere real.
ADMIN_API_KEY=swe-it-admin-dev-key

# Which origin(s) the website is allowed to call this API from.
# "*" is fine for local testing; lock this down to your real domain once deployed,
# e.g. ALLOWED_ORIGIN=https://it-assist.elsewedyelectric.com
ALLOWED_ORIGIN=*
